# The sign-in mode is discovered at runtime from the backend (GET /auth/config).
# VITE_AUTH_MODE (local | firebase) is only used when the backend cannot be reached.
# VITE_AUTH_MODE=local
# Firebase web config: required only when the backend runs AUTH_MODE=firebase; leave empty for AUTH_MODE=local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SENTRY_DSN=
VITE_PREMIUM_FOR_ALL_USERS=true
VITE_API_BASE_URL=http://localhost:3000
VITE_FLAG_MAINTENANCE=false
